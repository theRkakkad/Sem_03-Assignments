{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./NEXT_JS/Student_Directory/src/*",
        "./Student_Directory/src/*",
        "./src/*"
      ]
    }
  },
  "include": [
    "NEXT_JS/Student_Directory/**/*.ts",
    "NEXT_JS/Student_Directory/**/*.tsx",
    "Student_Directory/**/*.ts",
    "Student_Directory/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
